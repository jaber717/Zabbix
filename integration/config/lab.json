{
  "schema": "netbox-zabbix-sync-runtime-v1",
  "netbox_url": "http://192.168.1.89",
  "zabbix_url": "https://192.168.1.91:8443/api_jsonrpc.php",
  "zabbix_user": "Admin",
  "zabbix_credential_scope": "existing-admin-read-only-dry-run",
  "timeout_seconds": 10,
  "retries": 2,
  "tls": {
    "allow_insecure_netbox_http": true,
    "netbox_ca": null,
    "zabbix_ca": "/etc/netbox-zabbix-sync/zabbix-ca.crt"
  },
  "policy": {
    "change_budget": 0.10,
    "allow_apply_with_current_zabbix_credential": false,
    "required_endpoints": [
      "devices",
      "interfaces",
      "virtualization_interfaces",
      "ip_addresses",
      "virtual_machines",
      "tags",
      "custom_fields",
      "device_roles",
      "platforms",
      "sites",
      "tenants"
    ]
  }
}
