      "gridPos": {"h": 5, "w": 3, "x": 0, "y": 3},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "gray", "value": null}]}},
        "overrides": [
          {"matcher": {"id": "byRefId", "options": "A"}, "properties": [
            {"id": "displayName", "value": "PING"},
            {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}
          ]},
          {"matcher": {"id": "byRefId", "options": "B"}, "properties": [
            {"id": "displayName", "value": "SNMP"},
            {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "UNK", "color": "orange"}, "1": {"text": "OK",  "color": "green"}, "2": {"text": "DOWN", "color": "red"}}}]}
          ]},
          {"matcher": {"id": "byRefId", "options": "C"}, "properties": [
            {"id": "displayName", "value": "MEM"},
            {"id": "unit", "value": "percent"},
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}
          ]},
          {"matcher": {"id": "byRefId", "options": "D"}, "properties": [
            {"id": "displayName", "value": "CPU"},
            {"id": "unit", "value": "percent"},
            {"id": "noValue", "value": "—"},
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "gray", "value": null}, {"color": "green", "value": 0.0001}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}
          ]}
        ]
      },
      "options": {"reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": ""}, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal"},
