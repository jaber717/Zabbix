{
  "title": "NOC — Device Health (placeholder)",
  "uid": "noc-device-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m"], "time_options": ["1h", "6h", "24h", "7d"]},
  "fiscalYearStartMonth": 0,
  "style": "dark",
  "timezone": "browser",
  "tags": ["netops", "device-health", "placeholder"],
  "templating": {"list": [
    {"name": "host", "type": "custom", "label": "Host", "multi": false, "includeAll": false,
     "query": "PNET-STC,PNET-MOBILY,PNET-SAIX-A,PNET-SAIX-B,PNET-SITE-A,PNET-SITE-B,PNET-INT-CORE",
     "current": {"text": "PNET-STC", "value": "PNET-STC"}}
  ]},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$host — CPU utilisation",
      "datasource": {"type": "alexanderzobnin-zabbix-datasource", "uid": "zbx-noc"},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"refId": "A", "queryType": "0", "resultFormat": "time_series",
         "host": {"filter": "$host"},
         "item": {"filter": "/CPU utilization/"}}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "$host — Memory used",
      "datasource": {"type": "alexanderzobnin-zabbix-datasource", "uid": "zbx-noc"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"refId": "A", "queryType": "0", "resultFormat": "time_series",
         "host": {"filter": "$host"},
         "item": {"filter": "/Memory.*utilization/"}}
      ]
    }
  ],
  "description": "PLACEHOLDER until the exact Device Health item names on the Cisco IOSv template are confirmed by live inspection on grafana-01 (the current build host has no item.get permission). item.filter uses generic regexes; refine once we see the actual item names in the Zabbix datasource picker."
}
