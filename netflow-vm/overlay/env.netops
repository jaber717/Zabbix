# NetOps additions on top of upstream `.env`. Loaded AFTER the vendored .env.
# Nothing secret here; secrets stay in /etc/akvorado/* on the VM.

# Keep upstream's COMPOSE_FILE chain, then append our overlay.
COMPOSE_FILE=${COMPOSE_FILE}:netflow-vm/overlay/docker-compose.netops.yml

# Disable the console's `alfred` demo auth middleware when running in NetOps.
# flow-api/nginx is the real auth boundary; the console sits behind it.
AKVORADO_CFG_CONSOLE_BRANDING=NetOps WAN NetFlow
