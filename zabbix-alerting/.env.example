# Copy to .env (git-ignored) and fill in. One URL/token pair per environment.
# Use an API token of a Zabbix user that can: read hosts/items/templates, write host user macros,
# link templates, import configuration, create global macros, and manage actions (super admin
# role is simplest in LAB; in PRODUCTION use a dedicated service account).
ZABBIX_URL_LAB=https://zabbix-lab.example.local/zabbix
ZABBIX_TOKEN_LAB=
ZABBIX_URL_PRODUCTION=https://zabbix.example.com
ZABBIX_TOKEN_PRODUCTION=
