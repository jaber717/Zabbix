#!/usr/bin/env bash
set -Eeuo pipefail

[[ $# -eq 1 ]] || { printf 'Usage: %s BACKUP_DIRECTORY\n' "$0" >&2; exit 2; }
/usr/local/sbin/zabbix-offline-verify-backup "$1"
[[ -f /etc/zabbix-offline/release.json ]] || {
  printf 'ERROR: target release state is missing\n' >&2
  exit 1
}
printf '%s\n' \
  'RESTORE_ACTION=NOT_EXECUTED' \
  'REASON=Preflight is intentionally non-mutating; follow docs/BACKUP-RESTORE.md under separate authorization.' \
  'RESULT=PASS_PREFLIGHT'
