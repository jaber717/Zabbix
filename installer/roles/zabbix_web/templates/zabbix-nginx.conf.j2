{% if zabbix_tls_enabled | bool and zabbix_web_http_redirect | bool %}
server {
    listen {{ zabbix_web_http_port }};
    server_name {{ zabbix_web_server_name }};
    return 301 https://$host$request_uri;
}
{% endif %}

server {
{% if zabbix_tls_enabled | bool %}
    listen {{ zabbix_web_https_port }} ssl;
    ssl_certificate {{ zabbix_tls_certificate_path }};
    ssl_certificate_key {{ zabbix_tls_private_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZabbixTLS:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% else %}
    listen {{ zabbix_web_http_port }};
{% endif %}
    server_name {{ zabbix_web_server_name }};
    root /usr/share/zabbix;
    index index.php;

    location = /favicon.ico {
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location /assets {
        access_log off;
        expires 10d;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /(api/|conf[^.]|include|locale) {
        deny all;
        return 404;
    }

    location /vendor {
        deny all;
        return 404;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_pass unix:/run/php-fpm/zabbix.sock;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        fastcgi_param DOCUMENT_ROOT /usr/share/zabbix;
        fastcgi_param SCRIPT_FILENAME /usr/share/zabbix$fastcgi_script_name;
        fastcgi_param PATH_TRANSLATED /usr/share/zabbix$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_intercept_errors on;
        fastcgi_connect_timeout 60;
        fastcgi_send_timeout 180;
        fastcgi_read_timeout 180;
    }
}
