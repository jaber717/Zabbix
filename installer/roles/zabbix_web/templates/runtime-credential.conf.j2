[Service]
LoadCredentialEncrypted=db-password:{{ zabbix_db_credential_path }}
RuntimeDirectory=zabbix-web
RuntimeDirectoryMode=0750
Environment="ZABBIX_DB_HOST={{ zabbix_db_host }}"
Environment="ZABBIX_DB_PORT={{ zabbix_db_port }}"
Environment="ZABBIX_DB_NAME={{ zabbix_db_name }}"
Environment="ZABBIX_DB_USER={{ zabbix_db_user }}"
Environment="ZABBIX_DB_TLS={{ 1 if zabbix_db_tls | bool else 0 }}"
Environment="ZABBIX_SERVER_PORT={{ zabbix_server_listen_port }}"
Environment="ZABBIX_SERVER_NAME={{ zabbix_server_hostname }}"
ExecStartPre=+/usr/libexec/zabbix-offline/render-runtime-secret zabbix-web
