[Unit]
Description=Generate Zabbix daily network health report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zabbix-report
Group=zabbix-report
EnvironmentFile=-/etc/zabbix-daily-reporting/secrets.env
ExecStart=/usr/bin/python3 /opt/zabbix-daily-reporting/bin/zabbix_daily_report.py --config /etc/zabbix-daily-reporting/report.json
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zabbix-daily-reporting
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
