{
  "manifest_version": 2.0,
  "id": "netops_network_availability",
  "type": "widget",
  "name": "Network Availability v1",
  "namespace": "NetworkAvailability",
  "version": "1.0.2",
  "author": "NetOps",
  "description": "Platform-neutral Site, Node and Member availability with freshness and monitoring visibility.",
  "widget": {
    "name": "Network Availability v1",
    "size": {
      "width": 72,
      "height": 12
    },
    "js_class": "CWidgetNetworkAvailability",
    "use_time_selector": false,
    "refresh_rate": 30
  },
  "actions": {
    "widget.netops_network_availability.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "css": ["network-availability.css"],
    "js": ["class.widget.js"]
  }
}
